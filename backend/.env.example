# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fermeduvardier?schema=public"

# Redis (optional)
REDIS_URL="redis://:password@localhost:6379"

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email admin pour notifications de commandes
ADMIN_EMAIL=fermeduvardier@gmail.com

# Conseiller IA — optionnel. Mistral (https://console.mistral.ai), puis Gemini en secours (https://aistudio.google.com)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
